# Exemplo: Nginx termina TLS e encaminha tudo ao Apache local.
# Substitua domínio e certificados. Não sobrescreva a configuração existente sem adaptar.
server {
    listen 80;
    server_name carwash.exemplo.com;
    return 301 https://carwash.exemplo.com$request_uri;
}

server {
    listen 443 ssl;
    server_name carwash.exemplo.com;
    ssl_certificate /etc/letsencrypt/live/carwash.exemplo.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/carwash.exemplo.com/privkey.pem;

    client_max_body_size 8m;
    location ~ /\. { return 404; }
    location ~ ^/(app|bin|database|tests|storage|vendor|deploy)(/|$) { return 404; }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";
        proxy_connect_timeout 10s;
        proxy_read_timeout 60s;
        proxy_cache off;
    }
}
