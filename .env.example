# Ambiente: local durante desenvolvimento; production na hospedagem.
APP_ENV=local
# URL completa do site, sem barra final. Checkout requer HTTPS público.
APP_URL=http://127.0.0.1:8088
# IPs exatos do proxy que conecta ao Apache. Vazio = não confiar em cabeçalhos encaminhados.
# Exemplo para Nginx local: 127.0.0.1,::1 (Apache deve ouvir somente na interface interna).
TRUSTED_PROXIES=
# Chave permanente para criptografar as credenciais salvas pelo painel.
# Não substitua depois de salvar credenciais sem recadastrá-las.
APP_KEY=replace-with-64-random-hex-characters
# Conexão MySQL/MariaDB: mesmo driver PDO mysql, utf8mb4 e tabelas InnoDB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mazzuco_carwash
DB_USER=root
DB_PASS=
# Alternativa às credenciais criptografadas do painel (painel tem prioridade).
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# A seleção testes/produção é feita em Pagamentos > Configurar integração.
# Remetente para recuperação de senha. O servidor deve ter transporte de e-mail configurado.
MAIL_FROM=
